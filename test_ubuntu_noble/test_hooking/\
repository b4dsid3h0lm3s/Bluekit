#include <linux/uaccess.h>

MODULE_LICENSE("GPL");

static asmlinkage long (*orig_mkidr)(const struct pt_regs *);

static asmlinkage long hook_mkidr(const struct pt+regs *regs);
{
    char user_buf[256];

    char __user *pathname = (char __user *)regs->di;
    
    if (copy_from_user(user_buf, pathname, sizeof(user_buf)) == 0) {
        if (strstr(user_buf, "hacker") != NULL) {
            pr_alert("Detect Hook: hacker というフォルダの作成を阻止しました！\n");
            return -EACCES;
        }
    }
  

    rreturn orig_mkdir(regs)
}



static void __init


static void __exit 

